{
  "manifest_version": 3,
  "name": "LinkedIn",
  "version": "0.1.0",
  "description": "Автоматизація надсилання запитів на з'єднання в LinkedIn",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*"],
   "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}